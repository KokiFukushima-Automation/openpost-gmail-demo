# Copy to /etc/openpost/openpost.env, mode 600, owned by the openpost user/group.
# See docs/deploy.md for the full variable reference.

TRACKING_SECRET=replace-with-32-plus-random-characters
TRACKING_BASE_URL=https://track.example.com
DB_PATH=/var/lib/openpost/openpost.db
OUT_DIR=/var/lib/openpost/out
OPENPOST_CONFIG_DIR=/var/lib/openpost/config

FROM_EMAIL=you@example.com
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=replace-with-an-app-password

# Non-loopback binds require API_TOKEN (see docs/deploy.md's "binding off loopback" section).
BIND_ADDRESS=127.0.0.1
PORT=8787

DASHBOARD_PASSWORD=replace-with-a-real-password

# Optional: campaigns, backups, geo - all off/conservative by default.
# CAMPAIGNS_ENABLED=true
# BACKUP_ENABLED=true
# BACKUP_DIR=/var/lib/openpost/backups
# GEOIP_DB_PATH=/var/lib/openpost/GeoLite2-City.mmdb

# Optional: mobile (docs/mobile.md). A public HTTPS hostname (TRACKING_BASE_URL above) is required
# for Web Push and the service worker to work at all - browsers refuse both outside a secure context.
# NOTIFY_CHANNELS=webpush
# VAPID_PUBLIC_KEY=            # generate a matching pair with `openpost push keys --write-env`
# VAPID_PRIVATE_KEY=
# NOTIFY_EMAIL_TO=you@example.com
# DIGEST_DAILY_AT=08:00
