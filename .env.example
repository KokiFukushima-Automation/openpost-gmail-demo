# See docs/04_phase1_spec.md section 2 for full details on every variable.

# --- Required ---
# HMAC signing key for all tokens. Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64'))"
TRACKING_SECRET=

# Public origin used to build pixel/click/opt-out URLs. No trailing slash.
TRACKING_BASE_URL=http://127.0.0.1:8787

# Sending identity (required to send mail).
FROM_EMAIL=
FROM_NAME=

# --- Key rotation (optional) ---
# Accepted during verification only, so old tokens keep working while you roll TRACKING_SECRET.
TRACKING_SECRET_PREVIOUS=

# --- Privacy / IP hashing (optional) ---
# Salt base for daily-rotating IP hashes. Defaults to a value derived from TRACKING_SECRET.
IP_SALT=
# off | balanced | strict
PRIVACY_MODE=balanced
# Honour DNT:1 / Sec-GPC:1 headers.
RESPECT_DNT=true

# --- Server (optional) ---
DB_PATH=./data/openpost.db
PORT=8787
BIND_ADDRESS=127.0.0.1
# false (default) | true (trusts exactly 1 hop, with a startup warning) | an integer hop count |
# a comma-separated CIDR/IP allowlist. Only set this when running behind a trusted reverse proxy
# that sets X-Forwarded-For - trusting more hops than you actually have lets a client forge its
# own apparent IP. Enabling this requires API_TOKEN to be set (see API_TOKEN below).
TRUST_PROXY=false
LOG_LEVEL=info

# --- Classification rule thresholds (optional) ---
OPEN_IGNORE_SECONDS=10
PROXY_PREFETCH_SECONDS=60
MPP_WINDOW_SECONDS=900
DEDUPE_SECONDS=30
SCANNER_FANOUT=5
SELF_IP_HASHES=
SELF_UA_PATTERNS=

# --- Retention (optional) ---
RETENTION_DAYS=365

# --- Click tracking fallback (optional) ---
TRACKING_FALLBACK_URL=

# --- Dry-run transport (optional) ---
OUT_DIR=./out

# --- Mail transport (optional) ---
# dryrun | smtp | gmail | gmail-smtp
MAIL_TRANSPORT=dryrun

# SMTP fallback (e.g. a Gmail app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Gmail API transport (OAuth2, scopes: gmail.send, gmail.readonly)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Recipient semantics (optional; docs/07_recipient_semantics.md) ---
# auto | per-recipient | single. auto resolves to per-recipient everywhere except MAIL_TRANSPORT=gmail
# (which has no envelope override, so it resolves to single - one message, message-level tracking).
# RECIPIENT_MODE=per-recipient + MAIL_TRANSPORT=gmail is a config-time error.
RECIPIENT_MODE=auto
# gmail-smtp: OAuth2/XOAUTH2 submission to smtp.gmail.com (correct per-recipient CC semantics without
# an app password). 465 = implicit TLS (default); 587 selects STARTTLS. Run
# `openpost auth gmail --with-smtp` first (requests the broader https://mail.google.com/ scope -
# Gmail's SMTP front end refuses gmail.send).
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=465

# --- Local API (optional) ---
# Whenever this is set, every /api/* request requires "Authorization: Bearer <API_TOKEN>" -
# regardless of BIND_ADDRESS. The server refuses to start if BIND_ADDRESS is not loopback, or
# TRUST_PROXY is enabled, and this is unset (Phase 1.1 amendment - see docs/04_phase1_spec.md).
API_TOKEN=

# =====================================================================================
# Phase 2 (see docs/05_phase2_spec.md)
# =====================================================================================

# --- Notifications (optional) ---
NOTIFY_ENABLED=true
# Comma list of slack,discord,webhook,ntfy,webpush,email. Empty = queue only, no delivery.
NOTIFY_CHANNELS=
# Subset of first_open,read_confirmed,click,prefetched.
NOTIFY_ON=first_open,read_confirmed,click
NOTIFY_MAX_ATTEMPTS=4
NOTIFY_BACKOFF_BASE_MS=1000
NOTIFY_TICK_SECONDS=5
NOTIFY_TIMEOUT_MS=5000
NOTIFY_INCLUDE_SUBJECT=true
NOTIFY_REDACT_EMAIL=false

SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
# Both required together when "webhook" is listed in NOTIFY_CHANNELS.
WEBHOOK_URL=
WEBHOOK_SECRET=
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
NTFY_PRIORITY=default
# Phase 2.1 (finding #9): every notify channel URL above (plus NTFY_URL if you override it) is
# rejected at startup if it points at a loopback/link-local/RFC1918 address - set this to allow it
# anyway (e.g. a local webhook receiver for testing, or a same-host proxy).
NOTIFY_ALLOW_PRIVATE_URLS=false

# Server-sent events at GET /api/events/stream (independent of NOTIFY_ENABLED).
SSE_ENABLED=true
SSE_HEARTBEAT_SECONDS=15
SSE_MAX_CLIENTS=16

# --- Accuracy (optional) ---
# Click tracking is on by default; `send --no-track-clicks` overrides per-send.
TRACK_CLICKS_DEFAULT=true
# A counted click with no prior counted open implies a human read the message.
CLICK_BACKFILL_OPENS=true
RANGES_DIR=./data/ranges
RANGES_ENABLED=true

# window (Phase 1 send-window + fingerprint only) | insert (Gmail API untracked Sent copy,
# requires MAIL_TRANSPORT=smtp or gmail-smtp) | imap-append (SMTP-only alternative).
SELF_OPEN_STRATEGY=window
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_SENT_MAILBOX=[Gmail]/Sent Mail

# --- Privacy / ops scheduler (optional) ---
PRUNE_ENABLED=true
PRUNE_INTERVAL_HOURS=24
PRUNE_ON_START=false
PRUNE_VACUUM_THRESHOLD=10000
JOBS_ENABLED=true

# --- Gmail OAuth helper (optional; `openpost auth gmail`) ---
# Desktop-app OAuth client id/secret from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Overrides the on-disk token file (~/.config/openpost/gmail-token.json) when set.
GOOGLE_REFRESH_TOKEN=
# Defaults to ~/.config/openpost - where the Gmail token file and other local state live.
OPENPOST_CONFIG_DIR=

# --- openpost doctor (optional) ---
DOCTOR_TIMEOUT_MS=5000

# --- Phase 3: dashboard (optional) ---
DASHBOARD_ENABLED=true
# Disable permanent SSE connections in request-driven hosting; the UI shows Refresh instead.
DASHBOARD_LIVE=true
# Defaults to BIND_ADDRESS; a non-loopback value prints a startup warning and requires a secret.
DASHBOARD_BIND=
# Only used by `openpost dashboard` (the split-process mode).
DASHBOARD_PORT=8788
# Single password for the cookie session; required off loopback unless API_TOKEN is set.
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_HOURS=12
# auto (Secure iff TRACKING_BASE_URL is https) | true | false
DASHBOARD_SECURE_COOKIES=auto
DASHBOARD_PAGE_SIZE=25
DASHBOARD_MAX_EXPORT_ROWS=50000
DASHBOARD_LOGIN_RATE_PER_MIN=10
# IANA time zone for the best-hour histogram and day buckets (stats page, `openpost stats`).
REPORT_TIMEZONE=UTC
# Phase 3.1: /dashboard/stats and an unwindowed /api/stats?view=stats default to the last N days
# rather than all-time, and refuse a window wider than STATS_MAX_WINDOW_DAYS (pass an explicit
# ?since= to look further back, up to the max).
STATS_DEFAULT_WINDOW_DAYS=90
STATS_MAX_WINDOW_DAYS=366

# --- Phase 3: reminders (optional) ---
REMINDERS_ENABLED=true
REMINDER_TICK_SECONDS=30
REMINDER_LEASE_MS=120000
REMINDER_MAX_ATTEMPTS=3
REMINDER_MAX_HORIZON_DAYS=365
# no_reply | no_open | always - used when `openpost remind` omits --if.
REMINDER_DEFAULT_CONDITION=no_reply

# --- Phase 3: reply detection (optional) ---
# auto (Gmail if a gmail.readonly token is available, else IMAP if configured, else off) | off |
# gmail | imap
REPLY_DETECTION=auto
REPLY_POLL_SECONDS=300
REPLY_POLL_BATCH=25
REPLY_WATCH_DAYS=14
REPLY_QUOTA_UNITS_PER_MIN=300
# Comma-separated list of your own aliases that must never count as a reply.
REPLY_IGNORE_SENDERS=
# SMTP-only alternative to the Gmail API - reuses IMAP_HOST/IMAP_USER/IMAP_PASS above.
IMAP_ALL_MAIL_MAILBOX=[Gmail]/All Mail

# =====================================================================================
# Phase 4 (see docs/08_phase4_spec.md, docs/campaigns.md, docs/accounts.md)
# =====================================================================================

# --- Campaigns (optional) ---
CAMPAIGNS_ENABLED=true
CAMPAIGN_TICK_SECONDS=15
CAMPAIGN_RATE_PER_MINUTE=20
CAMPAIGN_JITTER_MS=4000
CAMPAIGN_LEASE_MS=120000
CAMPAIGN_MAX_ATTEMPTS=3
# Rolling 24h sent-message cap PER ACCOUNT; hitting it pauses the campaign until the window drains.
CAMPAIGN_DAILY_CAP=400
CAMPAIGN_MAX_ROWS=10000
CAMPAIGN_DIGEST_MINUTES=60
# digest (default, one notification per window) | per-open (Phase 2/3 behaviour) | off
NOTIFY_CAMPAIGN_MODE=digest

# --- Multi-account secrets at rest (optional; docs/accounts.md) ---
# Base64 or hex, >= 32 bytes decoded. Beats a keyfile. Generate with `openpost accounts init-key`.
OPENPOST_MASTER_KEY=
# Defaults to ${OPENPOST_CONFIG_DIR}/master.key. Must be mode 0600.
OPENPOST_MASTER_KEY_FILE=

# --- Backup (optional; `openpost backup`/`restore`) ---
BACKUP_ENABLED=false
BACKUP_DIR=./data/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7
BACKUP_GZIP=true

# --- Optional local geo (docs/08_phase4_spec.md §5) ---
# Path to a MaxMind GeoLite2/GeoIP2 City .mmdb you downloaded yourself. Unset = geo off entirely -
# openpost ships no geo data. Never applied to a proxied/machine-classified open.
GEOIP_DB_PATH=
# country | region | city - capped by PRIVACY_MODE (balanced caps at country; strict disables it).
GEOIP_GRANULARITY=country
GEOIP_MAX_AGE_DAYS=90

# --- In-Gmail checkmarks: server half only (optional; docs/extension.md) ---
# Exact-match, comma-separated origin allowlist for /api CORS. Empty (default) = no CORS headers
# at all. Requires API_TOKEN to be set; "*" is rejected.
API_CORS_ORIGINS=
# Window for the thread-lookup API's last-resort subject-based matching.
THREAD_LOOKUP_DAYS=30

# =====================================================================================
# Phase 5 (see docs/09_phase5_spec.md, docs/mobile.md)
# =====================================================================================

# --- Mobile compose + PWA (optional) ---
COMPOSE_ENABLED=true
COMPOSE_MAX_RECIPIENTS=25
COMPOSE_MAX_BODY_BYTES=262144
COMPOSE_RATE_PER_HOUR=20
# Emits the manifest/service-worker links and registers the worker; assets are always served
# regardless (they are needed for the offline fallback page even when this is off).
PWA_ENABLED=true

# --- Web Push (optional; docs/mobile.md) ---
# Generate a matching pair with `openpost push keys --write-env` - never hand-edit these.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Defaults to mailto:${FROM_EMAIL}. Must be mailto: or https:.
VAPID_SUBJECT=
PUSH_TTL_SECONDS=3600
# normal | high (a read_confirmed/reply notification always sends at "high" regardless).
PUSH_URGENCY=normal
PUSH_MAX_SUBSCRIPTIONS=10
PUSH_MAX_FAILURES=10

# --- Email-to-self notification channel + daily digest (optional) ---
# Add "webpush,email" to NOTIFY_CHANNELS above to enable either.
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=
# HH:MM local time (in DIGEST_TIMEZONE) to send one daily summary; unset = off.
DIGEST_DAILY_AT=
# Defaults to REPORT_TIMEZONE.
DIGEST_TIMEZONE=

# --- Gmail add-on: experimental, server half only (optional; addon/README.md) ---
ADDON_ENABLED=false
ADDON_RATE_PER_HOUR=120
ADDON_LINK_TIMEOUT_HOURS=48
