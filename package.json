{
  "name": "openpost",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Self-hostable Gmail open-tracking tool",
  "bin": {
    "openpost": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp -r src/db/migrations dist/db/ && cp -r src/server/assets dist/server/",
    "test:e2e": "playwright test",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "demo": "npm run build && node scripts/local-demo.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "fastify": "^5.0.0",
    "commander": "^12.1.0",
    "cheerio": "^1.0.0",
    "nodemailer": "^6.9.15",
    "googleapis": "^144.0.0",
    "dotenv": "^16.4.5",
    "cli-table3": "^0.6.5"
  },
  "optionalDependencies": {
    "imapflow": "^1.0.164",
    "mmdb-lib": "^3.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.2",
    "@vitest/coverage-v8": "^2.1.2",
    "tsx": "^4.19.1",
    "@types/node": "^22.7.5",
    "@types/better-sqlite3": "^7.6.11",
    "@types/nodemailer": "^6.4.16",
    "eslint": "^9.12.0",
    "@eslint/js": "^9.12.0",
    "typescript-eslint": "^8.8.1",
    "prettier": "^3.3.3",
    "@playwright/test": "^1.48.0"
  }
}
